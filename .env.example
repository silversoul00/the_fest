# ─────────────────────────────────────────────────────────────
# THE FEST — environment variables
# Copy to .env.local for local dev. In Vercel: Project → Settings →
# Environment Variables. Never commit real values.
# Step-by-step deploy guide: docs/LAUNCH-CHECKLIST.md
# [REQUIRED IN PRODUCTION] = /api/health answers 503 and lists the name until it is set.
# ─────────────────────────────────────────────────────────────

# [REQUIRED IN PRODUCTION] Copy from Supabase → your project → Connect (top bar) →
# "Transaction pooler" (port 6543 — the direct db.… address does not work from Vercel).
# The host is aws-0-… or aws-1-…: copy it exactly. Replace [YOUR-PASSWORD] with the database
# password, URL-encoding special characters (@ → %40, # → %23, / → %2F, : → %3A).
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-?-ap-south-1.pooler.supabase.com:6543/postgres

# [REQUIRED IN PRODUCTION] Ticket signing keys (ECDSA P-256). Make them at /setup/keys on the site
# (in the browser) or with:  npm run keys
# One line with \n for newlines. Use a different pair for Preview and Production.
# Never change them after tickets are sold — existing tickets would stop scanning.
TICKET_PRIVATE_KEY=
TICKET_PUBLIC_KEY=

# ── Payments ────────────────────────────────────────────────
# Cashfree (recommended: 0% on first ₹20 lakh for new merchants until 31 Mar 2027)
# Dashboard → Developers → API Keys. Use TEST keys first with CASHFREE_ENV=sandbox (Preview only).
# In production only LIVE keys with CASHFREE_ENV=production count; test keys there switch card
# checkout OFF (bank UPI and free tickets keep working) and /api/health reports it.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Force a gateway when both are configured: cashfree | razorpay (optional)
PAYMENT_GATEWAY=

# Razorpay (fallback) → Settings → API Keys. Test keys (rzp_test_...) work on Preview/local only;
# production needs rzp_live_... keys. With no gateway keys at all, card checkout is switched off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Settings → Webhooks → secret you set for event "payment.captured"
RAZORPAY_WEBHOOK_SECRET=

# [REQUIRED IN PRODUCTION] Public site address, used in emails, payment return links and booth QR codes.
# Production: https://thefest.in. Preview: leave EMPTY (the preview's own address is used).
# Production never falls back to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── THE FEST commission ─────────────────────────────────────
# flat: PLATFORM_FEE_PAISE per paid ticket (₹15 = 1500)
# percent: PLATFORM_FEE_PERCENT of ticket price, clamped to MIN/MAX (paise; MAX 0 = no cap)
PLATFORM_FEE_MODE=flat
PLATFORM_FEE_PAISE=1500
PLATFORM_FEE_PERCENT=5
PLATFORM_FEE_MIN_PAISE=800
PLATFORM_FEE_MAX_PAISE=3000
# Card/UPI gateway charge incl. GST, and whether students pay it (true) or you absorb it (false)
GATEWAY_RATE=0.0236
PASS_GATEWAY_FEE=true

# Who pays the platform fee: 'student' (added at checkout) or 'organizer' (deducted from payout)
PLATFORM_FEE_PAYER=student

# ── Email (Resend: free for 3,000 emails/month, 100/day) ────
# [REQUIRED IN PRODUCTION] Without a key, emails are only stored in the email_outbox table.
# EMAIL_FROM needs a domain verified in Resend. Before that, leave it EMPTY: Resend's test sender
# then delivers only to the email you signed up to Resend with.
RESEND_API_KEY=
EMAIL_FROM=

# ── Admin ───────────────────────────────────────────────────
# [REQUIRED IN PRODUCTION] Comma-separated emails that get the admin panel (/admin) once that
# account has confirmed its email. They also get the "new errors" alert emails.
ADMIN_EMAILS=you@example.com
# New fests need admin approval before tickets go on sale (set false to skip)
REQUIRE_FEST_APPROVAL=true

# Policy pages (/legal/*). Until these are set the pages show a highlighted "[… — to fill]".
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=support@thefest.in
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_GRIEVANCE_OFFICER=
# Set to 1 once a lawyer/CA has reviewed the wording; removes the "Draft" banner.
NEXT_PUBLIC_LEGAL_FINAL=

# Forwarded bank-alert emails: only these sender domains may confirm UPI orders on their own
# (comma-separated). Leave empty to use the built-in list of major Indian banks.
UPI_ALERT_SENDERS=

# ── Local testing only — NEVER set these in Vercel ──────────
# DEMO_PAYMENTS=1 allows the pretend "demo" card checkout when no gateway keys are set.
# It is ignored in production (Vercel production or APP_ENV=production), always.
DEMO_PAYMENTS=
# APP_ENV=production makes a local server behave like production (used by the release check).
APP_ENV=
